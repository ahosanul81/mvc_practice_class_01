
@{
    ViewBag.Title = "FileInfo";
}

<h2 class="display-4 text-center text-primary" >FileInfo</h2>

<div class="row">
    <div class="col">
        <table>
            <thead>

                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Extension</th>
                    <th>Size</th>
                    <th>Path</th>
                </tr>

            </thead>
            <tbody>
                @{
                    foreach (var f in ViewBag.res)
                    {
                        <tr>

                            <td>@f.Id</td>
                            <td style="max-width : 500px; text-wrap: wrap">@f.Name</td>
                            <td>@f.Extension</td>
                            <td>@f.Size</td>
                            <td>@f.Path</td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>
</div>

